CREATE TABLE OrderEntity (
    id                     TEXT    NOT NULL PRIMARY KEY,
    configId               TEXT    NOT NULL,
    adaptedModelId         TEXT,
    -- full config snapshot as JSON — immutable order history
    configJson             TEXT    NOT NULL,

    -- base price from catalogue
    basePrice              REAL    NOT NULL,
    currency               TEXT    NOT NULL,

    -- material surcharges: JSON map {"CARBON_FIBER": 28.0}
    materialSurchargesJson TEXT    NOT NULL DEFAULT '{}',

    -- texture surcharge (single value for selected texture)
    textureSurcharge       REAL    NOT NULL DEFAULT 0.0,

    -- personalisation surcharges
    inscriptionSurcharge   REAL    NOT NULL DEFAULT 0.0,

    -- element surcharges: JSON map {"LOGO": 8.0, "ENGRAVING": 6.0}
    elementSurchargesJson  TEXT    NOT NULL DEFAULT '{}',

    -- size multiplier applied after surcharges
    sizeMultiplier         REAL    NOT NULL DEFAULT 1.0,
    sizeMultiplierLabel    TEXT    NOT NULL DEFAULT '',

    -- quantity and totals
    quantity               INTEGER NOT NULL DEFAULT 1,
    subtotal               REAL    NOT NULL,   -- per unit after size multiplier
    totalPrice             REAL    NOT NULL,   -- subtotal × quantity

    status                 TEXT    NOT NULL,
    createdAt              INTEGER NOT NULL,
    FOREIGN KEY (configId) REFERENCES ProductConfigEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (adaptedModelId) REFERENCES AdaptedModel3DEntity(id) ON DELETE CASCADE
);

insertOrder:
INSERT OR REPLACE INTO OrderEntity
VALUES ?;

selectAllOrders:
SELECT * FROM OrderEntity
ORDER BY createdAt DESC;

selectOrderById:
SELECT * FROM OrderEntity
WHERE id = :id;

updateOrderStatus:
UPDATE OrderEntity
SET status = :status
WHERE id = :id;
-- called when we have the orderId directly
updateAdaptedModelId:
UPDATE OrderEntity
SET adaptedModelId = :adaptedModelId
WHERE id = :id;

selectOrderByConfigId:
SELECT * FROM OrderEntity
WHERE configId = :configId
LIMIT 1;

deleteAllOrders:
DELETE FROM OrderEntity;