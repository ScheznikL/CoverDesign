-- configId references ProstheticCoverOrderConfigEntity so multiple model iterations
-- (colour variants, revisions, bilateral cases) can be linked to one cover config.
-- Catalog-flow adapted models are linked via OrderEntity.adaptedModelId instead.
CREATE TABLE AdaptedModel3DEntity (
    id                   TEXT    NOT NULL PRIMARY KEY,
    configId             TEXT    NOT NULL,
    baseModelId          TEXT    NOT NULL,
    modelUrl             TEXT,
    previewImageUrl      TEXT,
    status               TEXT    NOT NULL DEFAULT 'PENDING',
    generatedAt          INTEGER NOT NULL,
    error                TEXT,
    progress             INTEGER NOT NULL DEFAULT 0,
    estimatedWaitSeconds INTEGER,
    FOREIGN KEY (configId) REFERENCES ProstheticCoverOrderConfigEntity(orderId) ON DELETE CASCADE
);

insertOrReplaceAdaptedModel:
INSERT OR REPLACE INTO AdaptedModel3DEntity VALUES ?;

selectByConfigId:
SELECT * FROM AdaptedModel3DEntity
WHERE configId = :configId
LIMIT 1;

selectAllByConfigId:
SELECT * FROM AdaptedModel3DEntity
WHERE configId = :configId
ORDER BY generatedAt DESC;

selectAdaptedById:
SELECT * FROM AdaptedModel3DEntity
WHERE id = :id;

updateAdaptedStatus:
UPDATE AdaptedModel3DEntity
SET status = :status
WHERE id = :id;

deleteAllAdaptedModels:
DELETE FROM AdaptedModel3DEntity;
